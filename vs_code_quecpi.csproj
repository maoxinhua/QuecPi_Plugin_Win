<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    vs_code_quecpi — QuecPi H1 VS Code 插件 Windows 版构建工程 (C# 项目壳)
    用 Visual Studio 打开 vs_code_quecpi.sln →
      右键项目 → 生成(Build)   = npm install → tsc → vsce 打包
      右键项目 → 重新生成(Rebuild) = 清理 out/dist → 上述流程
    产出: dist\vscode-quecpi-win.vsix
  -->
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{A917FE95-EF83-482C-B3C8-9E2260CDB3B1}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>vs_code_quecpi</RootNamespace>
    <AssemblyName>vs_code_quecpi</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="package.json" />
    <None Include="package-lock.json" />
    <None Include="tsconfig.json" />
    <None Include="src\**\*.ts" />
    <None Include="webview\**\*.js" />
    <None Include="README.md" />
    <None Include="README_WINDOWS.md" />
    <None Include="usbipd-wsl.sh" />
  </ItemGroup>

  <!-- 生成：npm install → compile → vsce package -->
  <Target Name="Build">
    <Message Text="[QuecPi] === Build: npm install ===" Importance="high" />
    <Exec Command="npm install --no-audit --no-fund" />

    <Message Text="[QuecPi] === Build: tsc compile ===" Importance="high" />
    <Exec Command="npm run compile" />

    <MakeDir Directories="dist" />
    <Message Text="[QuecPi] === Build: vsce package -&gt; dist\vscode-quecpi-win.vsix ===" Importance="high" />
    <Exec Command="npx @vscode/vsce package --no-dependencies --allow-missing-repository -o dist\vscode-quecpi-win.vsix" />

    <Message Text="[QuecPi] === DONE: dist\vscode-quecpi-win.vsix ===" Importance="high" />
  </Target>

  <!-- 清理 -->
  <Target Name="Clean">
    <Message Text="[QuecPi] === Clean ===" Importance="high" />
    <Exec Command="rmdir /s /q out" IgnoreExitCode="true" />
    <Exec Command="rmdir /s /q dist" IgnoreExitCode="true" />
  </Target>

  <!-- 重新生成 = Clean + Build -->
  <Target Name="Rebuild" DependsOnTargets="Clean;Build">
    <Message Text="[QuecPi] === Rebuild finished ===" Importance="high" />
  </Target>

  <!-- 空目标：避免 C# 默认编译链干预（无 .cs 源码） -->
  <Target Name="CoreCompile" />
</Project>
